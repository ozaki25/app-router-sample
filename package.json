{
  "name": "app-router-sample",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "markuplint": "markuplint \"**/*.tsx\"",
    "prettier": "prettier --write .",
    "tsc": "tsc --noEmit",
    "test": "vitest run --reporter=tree",
    "test:watch": "vitest --reporter=tree",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "dayjs": "1.11.19",
    "next": "16.0.7",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@markuplint/jsx-parser": "4.7.22",
    "@markuplint/react-spec": "4.5.22",
    "@storybook/nextjs": "10.1.4",
    "@tailwindcss/postcss": "4.1.17",
    "@trivago/prettier-plugin-sort-imports": "6.0.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.0.15",
    "baseline-browser-mapping": "2.9.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.7",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-storybook": "10.1.4",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "markuplint": "4.14.0",
    "msw": "2.12.4",
    "msw-storybook-addon": "2.0.6",
    "prettier": "3.7.4",
    "storybook": "10.1.4",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vitest": "4.0.15"
  },
  "lint-staged": {
    "*": [
      "prettier --ignore-unknown --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "bash -c 'tsc --noEmit'",
      "eslint --fix",
      "markuplint --fix"
    ]
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
